#!/usr/bin/env python3
"""Ultimate Mail, with a window."""
import os, sys, logging, argparse
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

p = argparse.ArgumentParser(prog="ultimate-mail-gtk")
p.add_argument("--db", help="use a different database file")
p.add_argument("-v", "--verbose", action="store_true")
p.add_argument("--screenshot", metavar="PATH",
               help="render the window to a PNG and exit (for development)")
p.add_argument("--screenshot-delay", type=float, default=3.0)
p.add_argument("--calendar", action="store_true",
               help="open on the calendar view")
p.add_argument("--chat", action="store_true", help="open on the chat view")
p.add_argument("--terminal", action="store_true",
               help="open on the terminal view")
args, rest = p.parse_known_args()

logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                    format="%(levelname)-7s %(name)s: %(message)s")

from ui.window import Application
sys.exit(Application(args.db, args.screenshot, args.screenshot_delay,
                     start_view=("calendar" if args.calendar
                                 else "chat" if args.chat
                                 else "terminal" if args.terminal else None)
                     ).run([sys.argv[0]] + rest))
